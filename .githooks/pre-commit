#!/bin/sh
#
# Blocks commits authored with an email that GitHub cannot link to the
# ErzaScarletTitania account. Commits made with an unlinked address show no
# avatar, no profile link, and earn no contribution credit.
#
# Enable this hook once per clone:
#   git config core.hooksPath .githooks

EXPECTED_EMAIL="101874050+ErzaScarletTitania@users.noreply.github.com"
ACTUAL_EMAIL="$(git config user.email)"

if [ "$ACTUAL_EMAIL" != "$EXPECTED_EMAIL" ]; then
    echo "COMMIT REJECTED: wrong author email." >&2
    echo >&2
    echo "  expected: $EXPECTED_EMAIL" >&2
    echo "  actual:   ${ACTUAL_EMAIL:-<unset>}" >&2
    echo >&2
    echo "GitHub links commits to an account by author email. Any other" >&2
    echo "address is shown as an unlinked name with no avatar, no profile" >&2
    echo "link, and no contribution credit." >&2
    echo >&2
    echo "Fix it for this repository:" >&2
    echo >&2
    echo "  git config user.email \"$EXPECTED_EMAIL\"" >&2
    echo >&2
    exit 1
fi

exit 0
